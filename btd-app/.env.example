# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real keys.

# Required for the AI advocacy assistant and the appointment-prep polish.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5. Set to claude-opus-5 for stronger
# answers at higher cost per message.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional, for login. Without these the site runs fine and the sign-in screen
# explains that it isn't connected yet. From your Supabase project's
# Settings → API page.
# VITE_SUPABASE_URL=https://yourproject.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only, for the "Delete account" button. From Supabase Settings → API
# (the service_role key). Never prefix this with VITE_ — that would put it in
# the browser bundle, where anyone could read it.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional. voiced@gmail.com is always an admin; add more people here,
# comma-separated, to let them reach /admin/stories.
# VITE_ADMIN_EMAILS=someone@example.com

# Only needed if you run the API somewhere other than the site itself
# (the default is same-origin, which is what the Vercel deployment uses).
# VITE_API_URL=https://your-api-host.example.com
